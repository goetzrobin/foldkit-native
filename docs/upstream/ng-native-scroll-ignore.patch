 .nx/version-plans/press-through-app-scroll.md |  7 ++
 packages/fabric/src/engine.ts                 | 26 ++++++-
 .../integration-tests/scroll-press.test.ts    | 67 ++++++++++++++++++-
 3 files changed, 97 insertions(+), 3 deletions(-)
 create mode 100644 .nx/version-plans/press-through-app-scroll.md

diff --git a/.nx/version-plans/press-through-app-scroll.md b/.nx/version-plans/press-through-app-scroll.md
new file mode 100644
index 00000000..80514bf0
--- /dev/null
+++ b/.nx/version-plans/press-through-app-scroll.md
@@ -0,0 +1,7 @@
+---
+__default__: patch
+---
+
+On iOS, a press or a long press on something inside a scroll view is no longer canceled when the app scrolls that view under the finger.
+
+Before, any scroll event canceled the press, so a list that scrolled itself with `scrollTo`, a changing content inset or `maintainVisibleContentPosition` took the touch from a finger resting on a row. A chat that follows a streaming reply never fired `longPress` on a message. A scroll the finger makes, and the momentum after it, cancel the press as before. Android is unchanged: its scroll events do not say who scrolled.
diff --git a/packages/fabric/src/engine.ts b/packages/fabric/src/engine.ts
index 12581d26..cb3f66c4 100644
--- a/packages/fabric/src/engine.ts
+++ b/packages/fabric/src/engine.ts
@@ -443,6 +443,25 @@ export interface FabricUIManager {
  */
 const SCROLL_CANCELS_PRESS = new Set(['topScroll', 'topScrollBeginDrag']);
 
+/**
+ * Whether a scroll event is one the app made, not a finger: `scrollTo`, a content inset that
+ * changed, content that grew above a kept position.
+ *
+ * Apple's hosts say so on the event. `RCTScrollViewComponentView` sets `responderIgnoreScroll` on
+ * each `topScroll` from `!_isUserTriggeredScrolling`, which a drag turns on and the end of its
+ * momentum turns off, and React Native's own responder leaves a marked scroll out of a transfer.
+ *
+ * Android's field cannot be read this way. `ScrollEvent.kt` sets it on every scroll, the finger's
+ * too, from a feature flag that is off, so there a scroll under a finger cancels the press
+ * whatever the field holds. And a drag that begins is the finger's on every platform.
+ */
+function isAppScroll(type: string, event: ResponderEvent): boolean {
+  if (type !== 'topScroll' || !isApplePlatform()) return false;
+  // A scroll's payload, though it arrives typed as the touch the responder otherwise handles.
+  const payload = event.nativeEvent as { responderIgnoreScroll?: unknown } | undefined;
+  return payload?.responderIgnoreScroll === true;
+}
+
 /**
  * RN's `directEventTypes`: delivered to the target only, never up the tree. Everything else
  * bubbles, which matches RN's `bubblingEventTypes` for the touch and input events that matter.
@@ -17942,10 +17961,15 @@ export class Engine implements HostEngine {
    *
    * Only a responder *inside* the thing that scrolled, so a scroll view moving does not cancel a
    * press somewhere else on screen. And only while a touch is in progress: momentum after the
-   * finger has lifted, and programmatic scrolling, have no press to cancel.
+   * finger has lifted has no press to cancel.
+   *
+   * A scroll the app made is not the finger's, though a finger can be down through it: a list
+   * that follows a message as it streams in scrolls itself under a finger resting on a row.
+   * {@link isAppScroll} passes those over, as React Native's responder does.
    */
   private cancelPressForScroll(target: EngineNode, type: string, event: ResponderEvent): void {
     if (!SCROLL_CANCELS_PRESS.has(type)) return;
+    if (isAppScroll(type, event)) return;
     const responder = this.currentResponder;
     if (!responder || responder === target) return;
     for (let node: EngineNode | null = responder; node; node = node.parent) {
diff --git a/packages/integration-tests/scroll-press.test.ts b/packages/integration-tests/scroll-press.test.ts
index 54657242..2c68059e 100644
--- a/packages/integration-tests/scroll-press.test.ts
+++ b/packages/integration-tests/scroll-press.test.ts
@@ -9,8 +9,9 @@
  * knows it is scrolling. Every platform cancels the touch at that moment, and so does this.
  */
 import assert from 'node:assert/strict';
-import { before, beforeEach, afterEach, describe, it } from 'node:test';
+import { after, before, beforeEach, afterEach, describe, it } from 'node:test';
 import type { Type } from '@angular/core';
+import { registerPlatformComponents } from '@ng-native/fabric';
 import { cleanup, render, screen, type FakeFabric } from '@ng-native/testing';
 import { compileFixture } from './compile.ts';
 
@@ -43,12 +44,18 @@ describe('a press in a list that scrolls', () => {
   const at = (y: number) => ({ pageX: 10, pageY: y });
   const touch = (id: string, type: string, y: number) =>
     fabric.emit(node(id), type, { touches: [at(y)], changedTouches: [at(y)], ...at(y) });
-  const scroll = () =>
+  const scroll = (extra: Record<string, unknown> = {}) =>
     fabric.emit(node('list'), 'topScroll', {
       contentOffset: { x: 0, y: 40 },
       contentSize: { width: 100, height: 900 },
       layoutMeasurement: { width: 100, height: 400 },
+      ...extra,
     });
+  // What iOS sends with a scroll no finger made: `scrollTo`, a content inset that changed, content
+  // that grew under `maintainVisibleContentPosition`. React Native sets it from
+  // `!_isUserTriggeredScrolling` (RCTScrollViewComponentView.mm), and its own responder leaves
+  // such a scroll out of a transfer.
+  const appScroll = () => scroll({ responderIgnoreScroll: true });
 
   it('fires an ordinary tap', async () => {
     touch('row', 'topTouchStart', 100);
@@ -92,4 +99,60 @@ describe('a press in a list that scrolls', () => {
     await settle();
     assert.equal(host.taps(), 1);
   });
+
+  it('fires when the app scrolled the list under a finger that stayed put', async () => {
+    // A chat that follows a reply as it streams in scrolls itself several times a second. A
+    // finger resting on a message through that is a press, or the start of a long one: the list
+    // moved, the finger did not ask it to.
+    touch('row', 'topTouchStart', 100);
+    appScroll();
+    appScroll();
+    touch('row', 'topTouchEnd', 100);
+    await settle();
+    assert.equal(host.taps(), 1);
+  });
+
+  it('does not fire when the finger scrolls a list the app is scrolling too', async () => {
+    // Only the app's own scrolls are passed over. One the finger makes, between two of them,
+    // still takes the touch.
+    touch('row', 'topTouchStart', 100);
+    appScroll();
+    scroll({ responderIgnoreScroll: false });
+    appScroll();
+    touch('row', 'topTouchEnd', 70);
+    await settle();
+    assert.equal(host.taps(), 0);
+  });
+
+  it('does not fire when a drag begins, whatever the scroll events after it say', async () => {
+    touch('row', 'topTouchStart', 100);
+    fabric.emit(node('list'), 'topScrollBeginDrag', {
+      contentOffset: { x: 0, y: 0 },
+      contentSize: { width: 100, height: 900 },
+      layoutMeasurement: { width: 100, height: 400 },
+      responderIgnoreScroll: true,
+    });
+    touch('row', 'topTouchEnd', 100);
+    await settle();
+    assert.equal(host.taps(), 0);
+  });
+
+  describe('on Android', () => {
+    // Android marks every scroll, the finger's included: `ScrollEvent.kt` sets the field from a
+    // feature flag that is off, not from who scrolled. So there the mark says nothing, and a
+    // scroll under a finger cancels as before.
+    before(() => registerPlatformComponents('android'));
+    after(() => {
+      registerPlatformComponents('ios');
+    });
+
+    it('does not fire when the list scrolled under the finger, though the scroll is marked', async () => {
+      touch('row', 'topTouchStart', 100);
+      scroll({ responderIgnoreScroll: true });
+      touch('row', 'topTouchMove', 70);
+      touch('row', 'topTouchEnd', 70);
+      await settle();
+      assert.equal(host.taps(), 0);
+    });
+  });
 });
