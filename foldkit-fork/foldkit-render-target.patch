+/** A place a view tree can be drawn other than the browser DOM, such as a
+ *  native view tree. A host registers one against the container object it
+ *  hands to `makeElement`; every patch for that container then goes through
+ *  the target instead of the DOM patch above. Containers with no registered
+ *  target take the DOM path unchanged. */
+export type RenderTarget = Readonly<{
+  /** First render: build `vnode` fresh inside `container`. */
+  mount: (
+    container: object,
+    vnode: VNode,
+    onRootPatched?: (vnode: VNode) => void,
+  ) => VNode
+  /** Every later render. */
+  patch: (
+    currentVNode: VNode,
+    vnode: VNode,
+    onRootPatched?: (vnode: VNode) => void,
+  ) => VNode
+  /** Dispose: `emptyVNode` is the tree after patching to nothing. Leave
+   *  `container` as it was before the first render. */
+  unmount: (container: object, emptyVNode: VNode) => void
+  /** When to run a scheduled render. Defaults to `requestAnimationFrame`,
+   *  which a host may lack or may pause. */
+  requestFrame?: (run: () => void) => void
+}>
+
+const renderTargets = new WeakMap<object, RenderTarget>()
+
+/** Registers the render target for a container. Returns a function that
+ *  removes the registration. */
+export const registerRenderTarget = (
+  container: object,
+  target: RenderTarget,
+): (() => void) => {
+  renderTargets.set(container, target)
+  return () => {
+    if (renderTargets.get(container) === target) {
+      renderTargets.delete(container)
+    }
+  }
+}
+
+/** Schedules a render for `container`: through its render target when that
+ *  supplies a frame source, otherwise on the next animation frame. */
+export const __requestRenderFrame = (
+  container: HTMLElement,
+  run: () => void,
+): void => {
+  const requestFrame = renderTargets.get(container)?.requestFrame
+  if (requestFrame !== undefined) {
+    requestFrame(run)
+    return
+  }
+  requestAnimationFrame(run)
+}
