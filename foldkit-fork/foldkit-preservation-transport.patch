+/** Where a runtime's preserved Model goes between two runs of the same
+ *  program. The default transport is the Vite dev server, reached through
+ *  `import.meta.hot`. A host with another bundler (Metro on a phone) or no
+ *  dev server at all sets its own with `setModelPreservationTransport`. */
+export type ModelPreservationTransport = Readonly<{
+  /** Stores the encoded Model for the runtime `id`. `isReloadFlush` is true
+   *  for the last store before the code is replaced. */
+  preserve: (id: string, encodedModel: unknown, isReloadFlush: boolean) => void
+  /** Answers a starting runtime with the encoded Model to restore, or
+   *  `undefined` to start fresh. */
+  resolve: (id: string) => Effect.Effect<unknown>
+  /** Registers `flush`, which the transport calls synchronously just before
+   *  the code is replaced. Returns a function that removes it. */
+  onBeforeReload: (flush: () => void) => () => void
+}>
+
+let maybeTransport: ModelPreservationTransport | undefined
+
+/** Routes Model preservation through `transport` in place of the Vite dev
+ *  server, and turns preservation on even where `import.meta.hot` is absent.
+ *  Set it before starting a runtime. Returns a function that removes it. */
+export const setModelPreservationTransport = (
+  transport: ModelPreservationTransport,
+): (() => void) => {
+  maybeTransport = transport
+  return () => {
+    if (maybeTransport === transport) {
+      maybeTransport = undefined
+    }
+  }
+}
+
+export const modelPreservationTransport = ():
+  | ModelPreservationTransport
+  | undefined => maybeTransport
