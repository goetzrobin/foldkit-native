{
  "expo": {
    "name": "Foldkit Showcase",
    "slug": "foldkit-native-showcase",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.foldkitnative.showcase"
    },
    "android": {
      "package": "dev.foldkitnative.showcase"
    },
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone to record voice notes.",
          "enableBackgroundRecording": true
        }
      ]
    ]
  }
}
