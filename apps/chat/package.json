    "effect": "4.1.0",
    "expo": "~58.0.16",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.14",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "foldkit": "file:../showcase/vendor/foldkit-0.171.0-native.3.tgz",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.2.0",
