  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@ng-native/metro": "0.25.0",
    "@ng-native/tailwind": "0.25.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "~19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
