{
  "expo": {
    "name": "Effect Chat",
    "slug": "effect-chat",
    "version": "0.1.0",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "dev.foldkitnative.euichat",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.foldkitnative.euichat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0E"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for voice notes in a chat."
        }
      ]
    ]
  }
}
