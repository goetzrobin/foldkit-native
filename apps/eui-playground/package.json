  "dependencies": {
    "@effect/ui": "file:../../packages/effect-ui-native/vendor/effect-ui-0.0.0.tgz",
    "@ng-native/fabric": "0.25.0",
    "effect": "4.1.6",
    "expo": "~58.0.16",
    "expo-clipboard": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/platform-node": "4.1.6",
    "@effect/ui-devtools": "file:../../packages/effect-ui-native/vendor/effect-ui-devtools-0.0.0.tgz",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
