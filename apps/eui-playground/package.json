{
  "name": "eui-playground",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npm run sync && expo start",
    "ios": "npm run sync && expo run:ios",
    "android": "npm run sync && expo run:android",
